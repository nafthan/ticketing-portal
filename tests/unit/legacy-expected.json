    "severity": "S3",
    "channel": "phone",
    "team": ""
   },
   "announce": null,
   "rules": {
    "noteToResolve": false,
    "timeToResolve": false,
    "maxActive": 0,
    "soonHours": 4,
    "autoCloseDays": 0,
    "maxShiftHours": 0,
    "graceDays": 3
   },
   "email": {
    "app": "outlook",
    "templates": {
     "opened": {
      "on": true,
      "subject": "[{ticket}] We've received your request: {subject}",
      "body": "Hi {contact},\n\nThanks for getting in touch. We've logged your request as {ticket} and the team is on it.\n\nSubject: {subject}\nPriority: {severity}\n\nWe'll keep you updated. Just reply to this email if anything changes.\n\n{helpdesk}"
     },
     "resolved": {
      "on": true,
      "subject": "[{ticket}] Resolved: {subject}",
      "body": "Hi {contact},\n\nGood news: we've resolved {ticket}.\n\n{resolution}\n\nIf the problem comes back, reply to this email and we'll pick it straight back up.\n\n{helpdesk}"
     },
     "closing": {
      "on": true,
      "subject": "[{ticket}] Closing soon: {subject}",
      "body": "Hi {contact},\n\nWe're closing {ticket}. If you still need help with it, reply by {closingDate} and we'll reopen it. After that it will be closed for good, and anything new will need a new ticket.\n\n{helpdesk}"
     },
     "closed": {
      "on": false,
      "subject": "[{ticket}] Closed: {subject}",
      "body": "Hi {contact},\n\n{ticket} is now closed. Thanks for your patience, and get in touch any time you need us.\n\n{helpdesk}"
     }
    }
   },
