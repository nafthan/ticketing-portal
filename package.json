{
  "name": "helpdesk",
  "version": "2.2.0",
  "private": true,
  "description": "A free, open-source ticketing system for IT, security and networking teams.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --mode clean --outDir dist/clean && node scripts/styles.mjs app",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/unit/",
    "styles": "node scripts/styles.mjs single",
    "styles:check": "node scripts/styles.mjs single --check",
    "smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  },
  "engines": {
    "node": ">=22.6"
  }
}
